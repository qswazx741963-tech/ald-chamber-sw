<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:local="clr-namespace:Ald.Hmi"
        x:Class="Ald.Hmi.MainWindow"
        Title="ALD Chamber" Width="1280" Height="800" MinWidth="1280" MinHeight="760" FontSize="14">
    <Window.Styles>
        <!-- 分頁標籤藏起來，改用底部導覽列切換 -->
        <Style Selector="TabControl#Tabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#AEB9C5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="TextBlock.cardHead">
            <Setter Property="Background" Value="#D5DDE6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.cardBody">
            <Setter Property="FontFamily" Value="monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,6" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6ECF2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#34475B" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.nav.sel">
            <Setter Property="Background" Value="#3D5A78" />
            <Setter Property="BorderBrush" Value="#F2D22E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>
    <!-- 底層版主畫面：狀態一覽 + 基本操作。完整的手動操作頁、Recipe 編輯、趨勢圖、權限之後再加。 -->
    <Grid>
    <DockPanel>
        <!-- 頂部：連線 / 系統狀態 / 系統操作 -->
        <Border DockPanel.Dock="Top" Padding="10,6" Background="#20303F">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <StackPanel x:Name="PnlTower" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="燈塔實際輸出：紅 異常 / 黃 警告或待機 / 綠 執行中 / 藍 需要人員處理">
                        <Ellipse x:Name="LmpRed" Width="16" Height="16" />
                        <Ellipse x:Name="LmpYellow" Width="16" Height="16" />
                        <Ellipse x:Name="LmpGreen" Width="16" Height="16" />
                        <Ellipse x:Name="LmpBlue" Width="16" Height="16" />
                        <TextBlock x:Name="TxtBuzzer" Foreground="White" Width="20" Text="" />
                    </StackPanel>
                    <Button x:Name="BtnAck" Content="確認 / 消音" Background="#E0E0E0" Foreground="Black" />
                    <TextBlock x:Name="TxtUser" Foreground="White" VerticalAlignment="Center" Text="未登入（檢視）" />
                    <Button x:Name="BtnLogin" Content="登入" Background="#E0E0E0" Foreground="Black" />
                    <Button x:Name="BtnReset" Content="Reset（解除安全狀態）" Background="#E0E0E0" Foreground="Black" />
                    <Button x:Name="BtnSafe" Content="安全停止" Background="#B03030" Foreground="White" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock x:Name="TxtState" Foreground="White" FontWeight="Bold" FontSize="16" Text="狀態：-" />
                            <TextBlock x:Name="TxtClock" Foreground="#C8D3DE" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="TxtLink" Foreground="#C8D3DE" FontSize="12" Text="主控板：未連線" />
                            <TextBlock x:Name="TxtSlots" Foreground="#C8D3DE" FontSize="12" Text="控制板：-" />
                            <TextBlock x:Name="TxtLl" Foreground="#C8D3DE" FontSize="12" Text="Loadlock：-" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#2B3D50" CornerRadius="3" Padding="8,2">
                        <TextBlock x:Name="TxtRecent" Foreground="#E6ECF2" FontSize="12" FontFamily="monospace" MaxLines="3" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 加熱常駐設定跟加熱板不一致（斷電 / 主站重開）：人員確認後才恢復加熱 -->
        <Border DockPanel.Dock="Top" x:Name="BarHeater" IsVisible="False" Padding="10,6" Background="#FFE8A0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnHeatRestore" Content="恢復常駐加熱設定" Background="#2E7D32" Foreground="White" />
                    <Button x:Name="BtnHeatAccept" Content="以目前為準（工程師）" />
                </StackPanel>
                <TextBlock x:Name="TxtHeaterBar" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="Black" />
            </DockPanel>
        </Border>

        <!-- 底部：最後訊息 + 導覽列（按鈕在程式裡依分頁產生） -->
        <Border DockPanel.Dock="Bottom" Padding="10,3" Background="#EEEEEE">
            <TextBlock x:Name="TxtStatusBar" Text="" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#20303F">
            <StackPanel x:Name="PnlNav" Orientation="Horizontal" />
        </Border>

        <TabControl x:Name="Tabs" Padding="0">
            <TabItem Header="總覽">
                <!-- 俯視圖總覽：左 作業 / Loadlock / MFC，中 俯視圖（OverviewView），右 PM / 真空 / 加熱 -->
                <Grid ColumnDefinitions="250,*,280" Margin="6" Background="#E4EAF1">
                    <ScrollViewer Grid.Column="0">
                        <StackPanel Spacing="8">
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Classes="cardHead" Text="作業" />
                                    <TextBlock x:Name="TxtRunNow" Classes="cardBody" TextWrapping="Wrap" />
                                    <WrapPanel Margin="6,0,6,6">
                                        <Button x:Name="BtnPump" Content="抽真空" Margin="0,0,6,6" />
                                        <Button x:Name="BtnVent" Content="回填大氣" Margin="0,0,6,6" />
                                        <Button x:Name="BtnAbort" Content="中止流程" Margin="0,0,6,6" Background="#F3D0D0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Classes="cardHead" Text="Loadlock" />
                                    <TextBlock x:Name="TxtLlDetail" Classes="cardBody" />
                                    <WrapPanel Margin="6,0,6,6">
                                        <Button x:Name="BtnLlPump" Content="LL 抽氣" Margin="0,0,6,6" />
                                        <Button x:Name="BtnLlVent" Content="LL 洩壓" Margin="0,0,6,6" />
                                        <Button x:Name="BtnSvOpen" Content="開 SV" Margin="0,0,6,6" />
                                        <Button x:Name="BtnSvClose" Content="關 SV" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Classes="cardHead" Text="氣體（MFC）" />
                                    <TextBlock x:Name="TxtMfc" Classes="cardBody" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <local:OverviewView Grid.Column="1" x:Name="Ov" Margin="6,0" />
                    <ScrollViewer Grid.Column="2">
                        <StackPanel Spacing="8">
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Classes="cardHead" Text="PM" />
                                    <TextBlock x:Name="TxtMech" Classes="cardBody" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Classes="cardHead" Text="真空" />
                                    <TextBlock x:Name="TxtVac" Classes="cardBody" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Classes="cardHead" Text="加熱" />
                                    <TextBlock x:Name="TxtHeat" Classes="cardBody" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="警報">
                <Grid RowDefinitions="Auto,*,Auto,2*" Margin="8">
                    <TextBlock Grid.Row="0" Text="目前警報（● = 未確認；按上方「確認 / 消音」）" FontWeight="Bold" />
                    <ListBox Grid.Row="1" x:Name="LstActive" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,4">
                        <TextBlock Text="事件記錄（最新在上）" FontWeight="Bold" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbEvtRange" Width="140" />
                        <ComboBox x:Name="CmbEvtLevel" Width="120" />
                        <TextBox x:Name="TxtEvtKey" Width="200" Watermark="關鍵字（來源 / 訊息）" />
                        <Button x:Name="BtnEvtQuery" Content="查詢" />
                        <CheckBox x:Name="ChkEvtLive" Content="自動更新" IsChecked="True" />
                        <Button x:Name="BtnEvtCsv" Content="匯出 CSV" />
                        <TextBlock x:Name="TxtEvtInfo" VerticalAlignment="Center" Foreground="#606060" />
                    </StackPanel>
                    <ListBox Grid.Row="3" x:Name="LstLog" FontFamily="monospace" />
                </Grid>
            </TabItem>
            <TabItem Header="手動操作">
                <!-- 命令一律走 MachineService；主控板 / 執行板的互鎖還是有效，被擋下會顯示原因。流程執行中整頁鎖住。 -->
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" x:Name="TxtManualLock" Foreground="#B03030" FontWeight="Bold" Margin="4,0,0,6" />
                    <Grid x:Name="PnlManual" ColumnDefinitions="*,*,*">
                        <!-- 真空 / ALD 閥 -->
                        <StackPanel Grid.Column="0" Spacing="4" Margin="4">
                            <TextBlock Text="真空閥 / 泵" FontSize="18" FontWeight="Bold" />
                            <StackPanel x:Name="PnlVac" Spacing="2" />
                            <TextBlock x:Name="TxtVacFb" FontFamily="monospace" TextWrapping="Wrap" />
                            <TextBlock Text="ALD 閥（手動脈衝前請確認管路）" FontSize="18" FontWeight="Bold" Margin="0,12,0,0" />
                            <WrapPanel x:Name="PnlAld" />
                            <Button x:Name="BtnAldAllOff" Content="ALD 閥全關" />
                        </StackPanel>
                        <!-- 加熱 / MFC -->
                        <StackPanel Grid.Column="1" Spacing="4" Margin="4">
                            <TextBlock Text="加熱" FontSize="18" FontWeight="Bold" />
                            <ComboBox x:Name="CmbHeater" HorizontalAlignment="Stretch" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" >
                                <TextBlock Grid.Row="0" Text="設定 °C" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="NumHeatSp" Minimum="0" Maximum="650" Increment="5" FormatString="0.0" />
                                <TextBlock Grid.Row="1" Text="升溫 °C/min" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NumHeatRamp" Value="0" Minimum="0" Maximum="100" Increment="1" FormatString="0.0" ToolTip.Tip="0 = 不限速" />
                            </Grid>
                            <WrapPanel>
                                <Button x:Name="BtnHeatOn" Content="開啟 / 套用" Margin="0,0,6,6" />
                                <Button x:Name="BtnHeatOff" Content="關閉此組" Margin="0,0,6,6" />
                                <Button x:Name="BtnHeatAllOff" Content="全部關閉" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock x:Name="TxtHeatInfo" FontFamily="monospace" />
                            <TextBlock Text="MFC" FontSize="18" FontWeight="Bold" Margin="0,12,0,0" />
                            <ComboBox x:Name="CmbMfc" HorizontalAlignment="Stretch" />
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock x:Name="TxtMfcUnit" Text="設定" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <NumericUpDown Grid.Column="1" x:Name="NumMfc" Value="0" Minimum="0" Maximum="2000" Increment="1" FormatString="0.0" />
                            </Grid>
                            <CheckBox x:Name="ChkMfcUp" Content="開上游閥（MFC__UP）" IsChecked="True" />
                            <WrapPanel>
                                <Button x:Name="BtnMfcApply" Content="套用" Margin="0,0,6,6" />
                                <Button x:Name="BtnMfcOff" Content="關此路" Margin="0,0,6,6" />
                                <Button x:Name="BtnMfcAllOff" Content="全部關閉" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock x:Name="TxtMfcInfo" FontFamily="monospace" />
                        </StackPanel>
                        <!-- PM 機構 -->
                        <StackPanel Grid.Column="2" Spacing="4" Margin="4">
                            <TextBlock Text="Heater module（步進）" FontSize="18" FontWeight="Bold" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Text="目標 step" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="NumAxisTarget" Value="0" Minimum="-2000000" Maximum="2000000" Increment="100" FormatString="0" />
                                <TextBlock Grid.Row="1" Text="速度 step/s" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NumAxisSpeed" Minimum="1" Maximum="20000" Increment="100" Value="1000" FormatString="0" />
                            </Grid>
                            <WrapPanel>
                                <Button x:Name="BtnAxisMove" Content="移動" Margin="0,0,6,6" />
                                <Button x:Name="BtnAxisHome" Content="原點復歸" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock x:Name="TxtAxisInfo" FontFamily="monospace" />
                            <TextBlock Text="Wafer lift（氣缸）" FontSize="18" FontWeight="Bold" Margin="0,12,0,0" />
                            <WrapPanel>
                                <Button x:Name="BtnLiftUp" Content="上升" Margin="0,0,6,6" />
                                <Button x:Name="BtnLiftDown" Content="下降" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock x:Name="TxtLiftInfo" FontFamily="monospace" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="傳片">
                <Grid ColumnDefinitions="*,*" Margin="8">
                    <StackPanel Grid.Column="0" Spacing="8" Margin="4">
                        <TextBlock Text="晶圓位置" FontSize="18" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border x:Name="BoxLl" Width="200" Height="90" CornerRadius="6" BorderBrush="#555" BorderThickness="2">
                                <TextBlock x:Name="TxtWaferLl" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="16" />
                            </Border>
                            <TextBlock Text="⇄ SV" VerticalAlignment="Center" FontSize="18" x:Name="TxtWaferSv" />
                            <Border x:Name="BoxPm" Width="200" Height="90" CornerRadius="6" BorderBrush="#555" BorderThickness="2">
                                <TextBlock x:Name="TxtWaferPm" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="16" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtWaferNote" Foreground="Gray" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="BtnXferLoad" Content="送片 LL → PM" Background="#2E7D32" Foreground="White" />
                            <Button x:Name="BtnXferUnload" Content="取片 PM → LL" Background="#2E7D32" Foreground="White" />
                            <Button x:Name="BtnXferAbort" Content="中止" Background="#B03030" Foreground="White" />
                        </StackPanel>
                        <TextBlock x:Name="TxtXferWhy" Foreground="#B03030" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtXferState" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="步驟記錄" FontWeight="Bold" />
                        <ListBox x:Name="LstXferLog" FontFamily="monospace" Height="300" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" Margin="16,4,4,4">
                        <TextBlock Text="PM / Loadlock 狀態" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="TxtXferStatus" FontFamily="monospace" />
                        <TextBlock Text="修正晶圓位置（工程師，確認實物後）" FontSize="18" FontWeight="Bold" Margin="0,16,0,0" />
                        <TextBlock Text="目前沒有晶圓感測器，位置靠流程記錄。流程中途失敗會變「不明」，看過實物後在這裡設定。" TextWrapping="Wrap" Foreground="Gray" />
                        <StackPanel x:Name="PnlWaferEdit" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Loadlock 手臂" Width="110" VerticalAlignment="Center" />
                                <ComboBox x:Name="CmbWaferLl" Width="120" />
                                <TextBlock Text="PM" Width="40" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <ComboBox x:Name="CmbWaferPm" Width="120" />
                            </StackPanel>
                            <Button x:Name="BtnWaferSet" Content="設定晶圓位置" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Recipe">
                <Grid ColumnDefinitions="3*,2*" Margin="8">
                    <!-- 左：選檔 + 編輯 -->
                    <DockPanel Grid.Column="0" Margin="4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <ComboBox x:Name="CmbRecipeFile" MinWidth="260" PlaceholderText="選擇配方檔" />
                            <Button x:Name="BtnRecipeReload" Content="重新整理" />
                            <Button x:Name="BtnRecipeNew" Content="新配方" />
                            <Button x:Name="BtnRecipeSave" Content="存檔" />
                        </StackPanel>
                        <ScrollViewer>
                            <StackPanel x:Name="PnlRecipeForm" Spacing="6">
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Text="名稱" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtRName" />
                                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="ChkRPump" Content="先抽真空到 base pressure" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Base (Torr)" VerticalAlignment="Center" Margin="12,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtRBase" />
                                    <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="ChkRVent" Content="結束後回填大氣" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Crossover (Torr)" VerticalAlignment="Center" Margin="12,0,8,0" />
                                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="TxtRCross" />
                                </Grid>
                                <TextBlock Text="需要的溫度 °C（只檢查、不改加熱設定；0 = 不檢查）" FontWeight="Bold" Margin="0,6,0,0" />
                                <Grid x:Name="GrdRHeat" ColumnDefinitions="Auto,110,Auto,110" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="容差 ±°C" VerticalAlignment="Center" />
                                    <NumericUpDown x:Name="NumRTol" Minimum="0.5" Maximum="50" Increment="0.5" FormatString="0.0" Width="110" />
                                    <TextBlock Text="未到位時需穩定 s" VerticalAlignment="Center" />
                                    <NumericUpDown x:Name="NumRSettle" Minimum="0" Maximum="36000" Increment="10" FormatString="0" Width="110" />
                                </StackPanel>
                                <TextBlock Text="MFC 設定（0 = 不用）" FontWeight="Bold" Margin="0,6,0,0" />
                                <Grid x:Name="GrdRMfc" ColumnDefinitions="Auto,110,Auto,110" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="通氣穩定 s" VerticalAlignment="Center" />
                                    <NumericUpDown x:Name="NumRGas" Minimum="0" Maximum="3600" Increment="1" FormatString="0" Width="110" />
                                </StackPanel>
                                <TextBlock Text="ALD 步驟（一行一步：名稱, 閥, ms；閥寫 V1+V3 或 -；空白 = 不跑 ALD）" FontWeight="Bold" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Cycles" VerticalAlignment="Center" />
                                    <NumericUpDown x:Name="NumRCycles" Minimum="1" Maximum="60000" Increment="10" FormatString="0" Width="130" />
                                    <TextBlock x:Name="TxtRAldTime" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox x:Name="TxtRSteps" AcceptsReturn="True" FontFamily="monospace" MinHeight="120" />
                                <TextBlock Text="逾時等進階欄位請直接改 JSON 檔，存檔時會保留。" Foreground="Gray" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                    <!-- 右：執行 -->
                    <DockPanel Grid.Column="1" Margin="12,4,4,4">
                        <StackPanel DockPanel.Dock="Top" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="晶圓編號" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtRunWafer" Width="160" Watermark="（選填，記在履歷）" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="BtnRecipeCheck" Content="檢查" />
                                <Button x:Name="BtnRecipeRun" Content="只跑製程" Background="#2E7D32" Foreground="White" ToolTip.Tip="片已經在 PM（或空跑）時用" />
                                <Button x:Name="BtnRecipeAuto" Content="自動跑片" Background="#1565C0" Foreground="White" ToolTip.Tip="送片 → 製程 → 取片 →（勾選時）回填" />
                                <Button x:Name="BtnRecipeAbort" Content="中止" Background="#B03030" Foreground="White" />
                            </StackPanel>
                            <TextBlock x:Name="TxtRunState" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtRunStep" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtRecipeMsg" Foreground="#B03030" TextWrapping="Wrap" />
                            <TextBlock Text="步驟記錄" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                        <ListBox x:Name="LstRunLog" FontFamily="monospace" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="批次">
                <Grid ColumnDefinitions="*,*" Margin="8">
                    <!-- 左：排片 -->
                    <DockPanel Grid.Column="0" Margin="4">
                        <StackPanel DockPanel.Dock="Top" Spacing="6" x:Name="PnlBatchEdit">
                            <TextBlock Text="多片批次" FontSize="18" FontWeight="Bold" />
                            <TextBlock Foreground="Gray" TextWrapping="Wrap" Text="每一片：Loadlock 洩壓 → 藍燈提示放片 / 取片、按確認 → 自動跑片（LL 抽氣 → 送片 → 製程 → 取片）。各片 PM 保持真空，回填只在整批結束後。任一片失敗整批停下。" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="配方" VerticalAlignment="Center" />
                                <ComboBox x:Name="CmbBatchRecipe" Width="260" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="晶圓編號" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtBatchId" Width="140" Text="W01" />
                                <TextBlock Text="片數" VerticalAlignment="Center" />
                                <NumericUpDown x:Name="NumBatchCount" Minimum="1" Maximum="50" Value="1" FormatString="0" Width="110" />
                                <Button x:Name="BtnBatchAdd" Content="加入" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnBatchDel" Content="刪除選取" />
                                <Button x:Name="BtnBatchClear" Content="清空" />
                                <CheckBox x:Name="ChkBatchVent" Content="整批結束後 PM 回填" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                            <Button x:Name="BtnBatchStart" Content="開始批次" />
                            <Button x:Name="BtnBatchAbort" Content="中止" />
                            <TextBlock x:Name="TxtBatchCheck" Foreground="#B03030" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420" />
                        </StackPanel>
                        <ListBox x:Name="LstBatch" FontFamily="monospace" Margin="0,6,0,0" />
                    </DockPanel>
                    <!-- 右：人員提示 + 狀態 -->
                    <DockPanel Grid.Column="1" Margin="12,4,4,4">
                        <Border DockPanel.Dock="Top" x:Name="PnlBatchPrompt" Background="#1E88E5" CornerRadius="6" Padding="12" IsVisible="False">
                            <StackPanel Spacing="8">
                                <TextBlock Text="需要人員處理" Foreground="White" FontSize="18" FontWeight="Bold" />
                                <TextBlock x:Name="TxtBatchPrompt" Foreground="White" FontSize="16" TextWrapping="Wrap" />
                                <Button x:Name="BtnBatchConfirm" Content="確認（已完成）" FontSize="16" Padding="16,8" Background="White" Foreground="Black" />
                            </StackPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" x:Name="TxtBatchState" FontWeight="Bold" FontSize="16" Margin="0,8,0,4" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="步驟記錄" FontWeight="Bold" />
                        <ListBox x:Name="LstBatchLog" FontSize="12" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="履歷">
                <!-- 跑片履歷：每片一筆，選一筆看當時配方 -->
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <ComboBox x:Name="CmbHistRange" Width="140" />
                        <ComboBox x:Name="CmbHistResult" Width="150" />
                        <TextBox x:Name="TxtHistKey" Width="240" Watermark="晶圓編號 / 配方 / 批次 / 使用者" />
                        <Button x:Name="BtnHistQuery" Content="查詢" />
                        <Button x:Name="BtnHistCsv" Content="匯出 CSV" />
                        <TextBlock x:Name="TxtHistInfo" VerticalAlignment="Center" Foreground="#606060" />
                    </StackPanel>
                    <Grid ColumnDefinitions="2*,*">
                        <ListBox Grid.Column="0" x:Name="LstHist" FontFamily="monospace" />
                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="8" BorderBrush="#C0C0C0" BorderThickness="1">
                            <ScrollViewer>
                                <TextBlock x:Name="TxtHistDetail" TextWrapping="Wrap" FontFamily="monospace" Text="（選一筆看當時的配方）" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="趨勢">
                <Grid ColumnDefinitions="230,*" Margin="8">
                    <!-- 左：選訊號 -->
                    <ScrollViewer Grid.Column="0">
                        <StackPanel x:Name="PnlTrendSignals" Spacing="0" />
                    </ScrollViewer>
                    <!-- 右：時間範圍 + 兩張圖 -->
                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <ComboBox x:Name="CmbTrendRange" Width="150" />
                            <CheckBox x:Name="ChkTrendLive" Content="即時更新" IsChecked="True" />
                            <Button x:Name="BtnTrendRefresh" Content="更新" />
                            <Button x:Name="BtnTrendCsv" Content="匯出 CSV" />
                            <TextBlock x:Name="TxtTrendInfo" VerticalAlignment="Center" Foreground="Gray" />
                        </StackPanel>
                        <Grid RowDefinitions="*,*">
                            <sp:AvaPlot Grid.Row="0" x:Name="PlotPressure" />
                            <sp:AvaPlot Grid.Row="1" x:Name="PlotTemp" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="保養" x:Name="TabMaint">
                <Grid ColumnDefinitions="*,*" Margin="8">
                    <!-- 左：漏率測試 -->
                    <DockPanel Grid.Column="0" Margin="4">
                        <StackPanel DockPanel.Dock="Top" Spacing="6">
                            <TextBlock Text="漏率測試（壓升法）" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="TxtLeakCfg" Foreground="Gray" TextWrapping="Wrap" />
                            <StackPanel x:Name="PnlLeakSet" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="量測" VerticalAlignment="Center" />
                                <NumericUpDown x:Name="NumLeakMeasure" Minimum="10" Maximum="7200" Increment="30" Value="300" FormatString="0" Width="120" />
                                <TextBlock Text="s   合格上限" VerticalAlignment="Center" />
                                <NumericUpDown x:Name="NumLeakLimit" Minimum="0.001" Maximum="1000" Increment="0.1" Value="1" FormatString="0.###" Width="120" />
                                <TextBlock Text="mTorr/min" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnLeakStart" Content="開始漏率測試" />
                                <Button x:Name="BtnLeakAbort" Content="中止" />
                            </StackPanel>
                            <TextBlock x:Name="TxtLeakState" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtLeakLive" FontFamily="monospace" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox x:Name="LstLeakHist" DockPanel.Dock="Bottom" Height="150" FontFamily="monospace" FontSize="12" />
                        <TextBlock DockPanel.Dock="Bottom" Text="歷史記錄" FontWeight="Bold" Margin="0,6,0,2" />
                        <sp:AvaPlot x:Name="PlotLeak" MinHeight="200" />
                    </DockPanel>
                    <!-- 右：保養計數 -->
                    <DockPanel Grid.Column="1" Margin="12,4,4,4">
                        <StackPanel DockPanel.Dock="Top" Spacing="4">
                            <TextBlock Text="保養計數" FontSize="18" FontWeight="Bold" />
                            <TextBlock Foreground="Gray" TextWrapping="Wrap" Text="依主控板回報的實際狀態累計。保養完成後選項目按「保養完成歸零」（總累計保留）。上限 0 = 不提醒；建議依各零件原廠手冊設定。" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" x:Name="PnlMaintEdit" Spacing="6" Margin="0,6,0,0">
                            <TextBlock x:Name="TxtMaintSel" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="提醒上限" VerticalAlignment="Center" />
                                <NumericUpDown x:Name="NumMaintLimit" Minimum="0" Maximum="1000000000" Increment="100" Value="0" FormatString="0.#" Width="180" />
                                <Button x:Name="BtnMaintLimit" Content="設定上限" />
                                <Button x:Name="BtnMaintReset" Content="保養完成歸零" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="LstMaint" FontFamily="monospace" FontSize="13" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="使用者">
                <Grid ColumnDefinitions="*,*" Margin="8">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="4">
                        <TextBlock Text="變更我的密碼" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="TxtMe" />
                        <TextBox x:Name="TxtMyOld" PasswordChar="●" Watermark="目前密碼" Width="260" HorizontalAlignment="Left" />
                        <TextBox x:Name="TxtMyNew" PasswordChar="●" Watermark="新密碼（4–64 字）" Width="260" HorizontalAlignment="Left" />
                        <TextBox x:Name="TxtMyNew2" PasswordChar="●" Watermark="再輸入一次新密碼" Width="260" HorizontalAlignment="Left" />
                        <Button x:Name="BtnMyPw" Content="變更密碼" />
                        <TextBlock Text="權限說明" FontSize="18" FontWeight="Bold" Margin="0,16,0,0" />
                        <TextBlock FontFamily="monospace" Text="檢視（未登入）：看畫面、安全停止、中止流程&#10;操作員：+ Reset、執行配方、抽真空 / 回填、Loadlock&#10;工程師：+ 手動操作、編輯 / 存檔配方、漏率測試、保養計數&#10;管理員：+ 使用者管理&#10;（傳片：操作員；修正晶圓位置：工程師）&#10;一段時間沒有操作自動登出（config hmi.idleLogoutMinutes）" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" x:Name="PnlUsers" Spacing="6" Margin="4">
                        <TextBlock Text="使用者管理（管理員）" FontSize="18" FontWeight="Bold" />
                        <ListBox x:Name="LstUsers" Height="220" />
                        <TextBox x:Name="TxtUName" Watermark="帳號" Width="260" HorizontalAlignment="Left" />
                        <ComboBox x:Name="CmbURole" Width="260" />
                        <TextBox x:Name="TxtUPw" PasswordChar="●" Watermark="密碼（新增 / 重設時填）" Width="260" HorizontalAlignment="Left" />
                        <WrapPanel>
                            <Button x:Name="BtnUAdd" Content="新增" Margin="0,0,6,6" />
                            <Button x:Name="BtnURole" Content="改等級" Margin="0,0,6,6" />
                            <Button x:Name="BtnUPw" Content="重設密碼" Margin="0,0,6,6" />
                            <Button x:Name="BtnUDel" Content="刪除" Margin="0,0,6,6" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
    <!-- 登入視窗（蓋在畫面上） -->
    <Border x:Name="PnlLogin" IsVisible="False" Background="#80000000">
        <Border Background="White" Padding="24" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <StackPanel Spacing="8">
                <TextBlock Text="登入" FontSize="20" FontWeight="Bold" />
                <TextBox x:Name="TxtLoginName" Watermark="帳號" />
                <TextBox x:Name="TxtLoginPw" PasswordChar="●" Watermark="密碼" />
                <TextBlock x:Name="TxtLoginErr" Foreground="#B03030" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="BtnLoginOk" Content="登入" IsDefault="True" />
                    <Button x:Name="BtnLoginCancel" Content="取消" IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
